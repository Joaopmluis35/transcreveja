{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "redirects": [
    { "source": "/index2.html", "destination": "/index.html", "permanent": true },
    { "source": "/admin.html", "destination": "/index.html", "permanent": true },
    { "source": "/archive/:path*", "destination": "/index.html", "permanent": true },
    { "source": "/api/:path*", "destination": "https://api.ouviescrevi.pt/api/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/s/:id", "destination": "https://api.ouviescrevi.pt/share/:id" }
  ]
}
