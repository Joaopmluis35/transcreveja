# Obrigatório
OPENAI_API_KEY=sk-...
ADMIN_TOKEN=gera-um-token-longo-para-admin-e-backoffice

# Token usado pelo frontend (operações de IA/transcrição). Se vazio, usa ADMIN_TOKEN.
# Em produção, preferir um token separado e rodá-lo regularmente.
API_TOKEN=

# Palavra-passe do backoffice (nunca colocar no HTML)
BACKOFFICE_PASSWORD=escolhe-uma-password-forte

# Origens permitidas (CORS + /api/frontend-config), separadas por vírgula
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://ouviescrevi.pt,https://www.ouviescrevi.pt
# Pré-visualização Cloudflare Pages (substitui pelo URL real, ex. https://ouviescrevi.pages.dev):
# ALLOWED_ORIGINS=...,https://ouviescrevi.pages.dev

# URL pública da API devolvida ao frontend
PUBLIC_API_BASE=https://api.ouviescrevi.pt

# development | production
APP_ENV=development

# Endpoints de diagnóstico (/debug, /test-email, /, /rotas) só em development
ENABLE_DEBUG_ENDPOINTS=true

# Rate limiting (pedidos por IP por janela em segundos; 0 = desativado)
RATE_LIMIT_TRANSCRIBE=20
RATE_LIMIT_TRANSCRIBE_WINDOW=3600
RATE_LIMIT_VIDEO_SUBS=10
RATE_LIMIT_VIDEO_SUBS_WINDOW=3600
RATE_LIMIT_AI=60
RATE_LIMIT_AI_WINDOW=3600

# SUBS_BURN_PRESET=ultrafast
# SUBS_BURN_CRF=23
# SUBS_BURN_MAX_WIDTH=1280
# SUBS_BURN_SEC_PER_SEC=1.0
# SUBS_TRANSCRIBE_SEC_PER_SEC=0.25
# VIDEO_CLEANUP_MAX_AGE_HOURS=36
# UPLOAD_CLEANUP_MAX_AGE_HOURS=2
# QUOTA_ANONYMOUS_DAILY=3
# QUOTA_REGISTERED_DAILY=20
# TOTAL_TRANSCRIBE_TIMEOUT=900
# WHISPER_LANGUAGE=pt   # vazio = auto-detect; só forçar se quiseres idioma fixo no servidor
# WHISPER_PROMPT=       # opcional; se vazio, prompt por idioma (pt/en) ou nenhum em auto

# Caminho da base SQLite local (só dev; omitir se usares Turso)
# DATABASE_PATH=ouviescrevi.db

# Turso Cloud — persistência grátis em produção (Render Free)
# Cria em https://turso.tech → turso db create ouviescrevi
# TURSO_DATABASE_URL=libsql://ouviescrevi-xxxx.turso.io
# TURSO_AUTH_TOKEN=

# Opcional — notificações por email (transcrições, atividade no site)
# No Render, SMTP (portas 465/587) costuma estar bloqueado — usa Resend (HTTPS):
# RESEND_API_KEY=re_...
# RESEND_FROM=Ouviescrevi <notificacoes@ouviescrevi.pt>
# SMTP_TO=ouviescrevi@gmail.com
#
# Alternativa local / VPS: SMTP Gmail
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=notificacoes@ouviescrevi.pt
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# LOG_LEVEL=INFO
